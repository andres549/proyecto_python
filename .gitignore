# Entornos virtuales
venv/
env/
.venv/

# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local
db.sqlite3
*.sqlite3

# Archivos estáticos recolectados
staticfiles/

# Logs estructurados
logs/*.log
*.log

# Cache de pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Archivos multimedia generados o subidos (excepto plantilla de muestra)
media/uploads/*
!media/uploads/.gitkeep
media/reports/*
!media/reports/.gitkeep

# Variables de entorno secretas
.env
