# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - APLICACIÓN EMPRESARIAL PYTHON
# ==============================================================================

# Clave secreta criptográfica de Django (no compartir en repositorios públicos)
DJANGO_SECRET_KEY=django-insecure-enterprise-automation-key-change-in-production-2026

# Modo de depuración (True para desarrollo, False para producción)
DJANGO_DEBUG=True

# Hosts autorizados separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Nivel de logging estructurado (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Base de datos: si está vacía, se usará SQLite local en el directorio base
# Para PostgreSQL de producción: postgresql://usuario:password@localhost:5432/db_enterprise
DATABASE_URL=
